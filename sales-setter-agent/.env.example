# Anthropic API Key — Powers Claude Opus 4.6 for conversation intelligence
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs API Key — Powers voice (speech-to-text + text-to-speech)
ELEVENLABS_API_KEY=...

# ElevenLabs Agent ID — Created via POST /api/agent (run setup once)
ELEVENLABS_AGENT_ID=...

# ElevenLabs Voice ID (optional — defaults to "George", a calm professional voice)
# Browse voices at https://elevenlabs.io/voice-library
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Public URL where ElevenLabs can reach your LLM proxy
# In development, use ngrok or similar tunnel: https://your-tunnel.ngrok.io/api/llm
# In production, use your deployed URL: https://your-app.vercel.app/api/llm
LLM_WEBHOOK_URL=https://your-domain.com/api/llm

# Calendly Personal Access Token
CALENDLY_API_KEY=...

# Calendly Event Type URI (the specific event to book)
# Format: https://api.calendly.com/event_types/XXXXXXXX
CALENDLY_EVENT_TYPE_URI=...

# Alinka's Calendly scheduling link (public-facing)
CALENDLY_SCHEDULING_URL=...
