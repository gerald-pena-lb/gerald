# ElevenLabs API Key — Powers voice (speech-to-text + text-to-speech)
ELEVENLABS_API_KEY=...

# ElevenLabs Agent ID — Created via /setup page
ELEVENLABS_AGENT_ID=...

# Public agent ID for the widget (same as ELEVENLABS_AGENT_ID but exposed to browser)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=...

# Calendly Personal Access Token
CALENDLY_API_KEY=...

# Calendly Event Type URI (optional — visit /api/calendly/lookup to find it)
CALENDLY_EVENT_TYPE_URI=...

# Alinka's Calendly scheduling link (public-facing)
CALENDLY_SCHEDULING_URL=https://calendly.com/talktoalinka/author-call
